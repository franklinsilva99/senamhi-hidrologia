/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["vitest/globals"],
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["app/core/*"],
      "@core/models/*": ["app/core/models/*"],
      "@core/services/*": ["app/core/services/*"],
      "@features/*": ["app/features/*"],
      "@features/private/*": ["app/features/private/*"],
      "@features/private/components/*": ["app/features/private/components/*"],
      "@features/private/pages/*": ["app/features/private/pages/*"],
      "@environments/*": ["environments/*"],
      "@assets/*": ["assets/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
